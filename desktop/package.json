{
  "name": "nuvia-desktop",
  "version": "2.6.0",
  "description": "Nuvia peer-to-peer desktop messenger",
  "main": "main.js",
  "author": "Arad649",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.arad.nuvia.desktop",
    "productName": "Nuvia",
    "asar": true,
    "files": [
      "main.js",
      "index.html",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.png",
      "artifactName": "Nuvia-PC-${version}.${ext}"
    }
  }
}
